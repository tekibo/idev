#!/usr/bin/env python3
"""`ipconfig` for Linux — enough for React Native's debug bundle host.

`react-native-xcode.sh` writes the packager host into the app bundle with

    IP=$(ipconfig getifaddr en0 || ipconfig getifaddr en1)

so without this the Debug bundle ships an empty `ip.txt` and the app cannot
find Metro on its own.
"""

from __future__ import annotations

import shutil
import subprocess
import sys


def primary_address() -> str:
    if shutil.which("ip"):
        try:
            result = subprocess.run(
                ["ip", "-4", "route", "get", "1.1.1.1"],
                capture_output=True, text=True, timeout=5,
            )
            tokens = result.stdout.split()
            for index, token in enumerate(tokens):
                if token == "src" and index + 1 < len(tokens):
                    return tokens[index + 1]
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        result = subprocess.run(
            ["hostname", "-I"], capture_output=True, text=True, timeout=5
        )
        for token in result.stdout.split():
            if token.count(".") == 3:
                return token
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def address_of(interface: str) -> str:
    try:
        result = subprocess.run(
            ["ip", "-4", "addr", "show", interface],
            capture_output=True, text=True, timeout=5,
        )
        for line in result.stdout.splitlines():
            line = line.strip()
            if line.startswith("inet "):
                return line.split()[1].split("/")[0]
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def main() -> int:
    arguments = sys.argv[1:]
    if arguments and arguments[0] == "getifaddr":
        interface = arguments[1] if len(arguments) > 1 else ""
        address = address_of(interface) if interface else ""
        if not address:
            address = primary_address()
        if address:
            print(address)
            return 0
        return 1
    # Other subcommands are not used by the build; succeed quietly.
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
