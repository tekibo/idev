#!/usr/bin/env python3
"""Verify that every Mach-O in an app bundle can find its dependencies.

A build can succeed and still produce an app that dies in dyld:

    Library not loaded: @rpath/ExpoModulesJSI.framework/ExpoModulesJSI

That happens when a framework is referenced but not embedded. Checking the
closure before the bundle leaves the build directory turns a launch-time crash
into a build failure with the missing path printed.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

MACHO_MAGICS = {
    b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe",
    b"\xfe\xed\xfa\xcf", b"\xfe\xed\xfa\xce",
    b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca",
}
SYSTEM_PREFIXES = ("/usr/lib/", "/System/", "/Library/Frameworks/")


def log(message: str) -> None:
    print(f"audit-app-closure: {message}", file=sys.stderr)


def configuration_from(derived: str) -> tuple[str, str]:
    """Read configuration and platform from Swift Build's parameters."""
    parameters = os.path.join(derived, "build-parameters.json")
    configuration, platform = "Release", "iphoneos"
    try:
        with open(parameters, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return configuration, platform
    configuration = data.get("configurationName") or configuration
    destination = data.get("activeRunDestination") or {}
    platform = destination.get("platform") or platform
    return configuration, platform


def macho_files(root: str):
    for directory, _dirs, files in os.walk(root):
        for name in files:
            path = os.path.join(directory, name)
            if os.path.islink(path):
                continue
            try:
                with open(path, "rb") as handle:
                    if handle.read(4) in MACHO_MAGICS:
                        yield path
            except OSError:
                continue


def dependencies(binary: str) -> list[str]:
    result = subprocess.run(
        ["llvm-objdump", "--macho", "--dylibs-used", binary],
        capture_output=True, text=True,
    )
    found = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line.startswith("@"):
            continue
        found.append(line.split(" (compatibility")[0].strip())
    return found


def resolves(dependency: str, binary: str, app: str, frameworks: str) -> bool:
    if dependency.startswith(SYSTEM_PREFIXES):
        return True
    if dependency.startswith("@rpath/"):
        relative = dependency[len("@rpath/"):]
        # The app's rpaths are @executable_path/Frameworks and friends.
        for root in (frameworks, app):
            if os.path.exists(os.path.join(root, relative)):
                return True
        return False
    if dependency.startswith("@executable_path/"):
        return os.path.exists(os.path.join(app, dependency[len("@executable_path/"):]))
    if dependency.startswith("@loader_path/"):
        relative = dependency[len("@loader_path/"):]
        return os.path.exists(os.path.join(os.path.dirname(binary), relative))
    # Absolute paths outside the system directories must exist too.
    return os.path.exists(dependency)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("app", nargs="?")
    parser.add_argument("--derived", help="DerivedData directory containing build-parameters.json")
    arguments = parser.parse_args()

    app = arguments.app
    if not app:
        if not arguments.derived:
            parser.error("either an app bundle or --derived is required")
        configuration, platform = configuration_from(arguments.derived)
        products = os.path.join(arguments.derived, "Build", "Products", f"{configuration}-{platform}")
        apps = [
            os.path.join(products, entry)
            for entry in sorted(os.listdir(products))
            if entry.endswith(".app")
        ] if os.path.isdir(products) else []
        if not apps:
            print("app closure skipped (no app bundle)")
            return 0
        app = apps[0]

    app = os.path.abspath(app)
    frameworks = os.path.join(app, "Frameworks")
    missing: dict[str, list[str]] = {}
    checked = 0

    for binary in macho_files(app):
        checked += 1
        for dependency in dependencies(binary):
            if not resolves(dependency, binary, app, frameworks):
                missing.setdefault(os.path.relpath(binary, app), []).append(dependency)

    if not missing:
        print(f"app closure OK ({checked} Mach-O files)")
        return 0

    log(f"{len(missing)} binary/binaries reference libraries that are not embedded:")
    for binary, deps in sorted(missing.items()):
        print(f"  {binary}")
        for dependency in deps:
            print(f"    missing {dependency}")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
