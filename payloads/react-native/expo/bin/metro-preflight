#!/usr/bin/env python3
"""Keep Metro's port deterministic for a project.

An interrupted `expo start` or `expo run:ios` can leave a Metro process
listening on 8081. Expo then picks another port, and an app built for a
different port can open a blank screen ("no script URL provided").

This preflight removes only a *stale* Metro belonging to the current project:
its working directory is inside the project and its parent is gone (or is no
longer an Expo CLI). A live server started by the user, or a server for a
different project, is left alone; in that case Expo is free to choose another
port, and the PIF now carries that port into the app.
"""

from __future__ import annotations

import argparse
import os
import re
import signal
import subprocess
import sys
import time

DEFAULT_PORT = 8081


def parse_port(arguments: list[str]) -> int:
    for index, argument in enumerate(arguments):
        if argument == "--port" and index + 1 < len(arguments):
            try:
                return int(arguments[index + 1])
            except ValueError:
                return DEFAULT_PORT
        if argument.startswith("--port="):
            try:
                return int(argument.split("=", 1)[1])
            except ValueError:
                return DEFAULT_PORT
    return DEFAULT_PORT


def listening_pids(port: int) -> list[int]:
    try:
        result = subprocess.run(
            ["ss", "-ltnp", f"sport = :{port}"],
            capture_output=True, text=True,
        )
    except OSError:
        return []
    return sorted({int(match.group(1)) for match in re.finditer(r"pid=(\d+)", result.stdout)})


def proc_cwd(pid: int) -> str | None:
    try:
        return os.path.realpath(os.readlink(f"/proc/{pid}/cwd"))
    except OSError:
        return None


def proc_status(pid: int) -> dict[str, str]:
    fields: dict[str, str] = {}
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                key, _, value = line.partition(":")
                fields[key.strip()] = value.strip()
    except OSError:
        pass
    return fields


def proc_cmdline(pid: int) -> str:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            return handle.read().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return ""


def is_inside(path: str, root: str) -> bool:
    return path == root or path.startswith(root + os.sep)


def is_orphan(pid: int) -> bool:
    ppid = int(proc_status(pid).get("PPid", "0") or 0)
    if ppid <= 1:
        return True
    parent = proc_cmdline(ppid)
    # A Metro whose parent is still the Expo CLI is serving an active session.
    return "expo" not in parent and "metro" not in parent


def stop(pid: int) -> None:
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        return
    deadline = time.time() + 5
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except OSError:
            return
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except OSError:
        pass


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project", default=os.environ.get("EXPO_PROJECT_DIR") or os.getcwd())
    parser.add_argument("arguments", nargs=argparse.REMAINDER)
    options = parser.parse_args()
    project = os.path.realpath(options.project)
    port = parse_port(options.arguments)

    for pid in listening_pids(port):
        cwd = proc_cwd(pid)
        if not cwd or not is_inside(cwd, project):
            continue
        if is_orphan(pid):
            print(
                f"metro-preflight: stopping stale Metro (pid {pid}) on port {port}",
                file=sys.stderr,
            )
            stop(pid)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
